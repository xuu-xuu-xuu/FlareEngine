<Project>
  <PropertyGroup>
    <FlareEngineRepositoryRoot Condition="'$(FlareEngineRepositoryRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</FlareEngineRepositoryRoot>
    <DirectoryBuildTargetsPath Condition="'$(DirectoryBuildTargetsPath)' == ''">$(MSBuildThisFileDirectory)Directory.Build.targets</DirectoryBuildTargetsPath>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>
    <RestorePackagesPath>$(FlareEngineRepositoryRoot)out\nuget\packages</RestorePackagesPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <FlareEngineManagedOutputRoot Condition="'$(FlareEngineManagedOutputRoot)' == ''">$(FlareEngineRepositoryRoot)out\managed\</FlareEngineManagedOutputRoot>
    <FlareEngineManagedIntermediateRoot Condition="'$(FlareEngineManagedIntermediateRoot)' == ''">$(FlareEngineRepositoryRoot)out\obj\</FlareEngineManagedIntermediateRoot>
    <BaseOutputPath>$(FlareEngineManagedOutputRoot)$(MSBuildProjectName)\</BaseOutputPath>
    <OutputPath Condition="'$(OutputPath)' == ''">$(BaseOutputPath)$(Configuration)\</OutputPath>
    <BaseIntermediateOutputPath>$(FlareEngineManagedIntermediateRoot)$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="FlareEngine" />
  </ItemGroup>
</Project>
